# Copia este archivo como .env.local y completa solo lo que necesites.
# Ninguna de estas variables debe contener secretos: todo lo que empieza
# por VITE_ termina en el código del navegador.

# Endpoint del proxy del asistente (servidor propio que llama al LLM).
# Si se deja vacío, se usa el asistente guiado local.
VITE_ASSISTANT_ENDPOINT=

# Endpoint que recibe los formularios de eBook y contacto (POST JSON).
# Si se deja vacío, los envíos se guardan solo en este dispositivo.
VITE_LEADS_ENDPOINT=
