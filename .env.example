# ─────────────────────────────────────────────────────────────────────────────
# Amor Tóxico · variables de entorno
#
# Copia este archivo como `.env` (desarrollo) o pega los valores en el panel de
# tu proveedor (producción). NUNCA subas `.env` ni claves reales al repositorio.
# Todo lo que está vacío es opcional: la app funciona sin ello con una
# alternativa segura (correo en consola, asistente guiado, "planes próximamente"…).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Dirección pública de la web (se usa en enlaces de correo, OAuth y Stripe).
APP_URL=http://localhost:5173
# Orígenes extra permitidos para la API, separados por comas (normalmente vacío).
CORS_ORIGINS=
# Pon `true` si la app está detrás de un proxy (Railway, Render, Fly, nginx).
TRUST_PROXY=false
LOG_LEVEL=info

# ── Base de datos ───────────────────────────────────────────────────────────
# SQLite (un solo servidor):   sqlite:./data/amor.db
# Postgres (recomendado):      postgres://usuario:clave@host:5432/amor
DATABASE_URL=sqlite:./data/amor.db
# Solo para docker-compose.yml (Postgres incluido): contraseña de la base de datos.
POSTGRES_PASSWORD=
# Clave que cifra los datos sincronizados. Obligatoria en producción.
# Genérala con `npm run secrets` y guárdala también en un gestor de contraseñas.
DATA_ENCRYPTION_KEY=
SESSION_DAYS=30
# Correos que reciben el rol de administración al registrarse (separados por comas).
ADMIN_EMAILS=

# ── Correo ──────────────────────────────────────────────────────────────────
# console = los correos se muestran en la terminal y en /dev/correo (solo desarrollo)
# resend  = usa RESEND_API_KEY (https://resend.com)
# smtp    = usa SMTP_URL, p. ej. smtps://usuario:clave@smtp.proveedor.com:465
EMAIL_TRANSPORT=console
EMAIL_FROM=Amor Tóxico <hola@amortoxico.com>
RESEND_API_KEY=
SMTP_URL=
# Correo que recibe el aviso de cada mensaje del formulario de contacto.
CONTACT_INBOX=
# Enlace de descarga del eBook (se envía tras confirmar el correo).
EBOOK_URL=

# ── Entrar con Google / Apple (opcional) ────────────────────────────────────
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer → Identifiers → Services ID + clave "Sign in with Apple".
# URL de retorno: {APP_URL}/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del archivo .p8 (puedes reemplazar los saltos de línea por \n).
APPLE_PRIVATE_KEY=

# ── Asistente con IA (opcional) ─────────────────────────────────────────────
# none = asistente guiado sin IA · openai = API compatible con OpenAI · anthropic = Claude
LLM_PROVIDER=none
LLM_API_KEY=
# p. ej. gpt-4o-mini o claude-3-5-haiku-latest
LLM_MODEL=
# Solo para proveedores compatibles con OpenAI distintos de OpenAI (Azure, Together, Groq…).
LLM_BASE_URL=
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=30000

# ── Pagos con Stripe (opcional; sin esto se muestra "planes próximamente") ─
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint {APP_URL}/api/billing/webhook
# Eventos: checkout.session.completed, customer.subscription.created,
#          customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# IDs de precio (price_…) del producto premium.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Notificaciones push (opcional) ──────────────────────────────────────────
# Genera el par con `npm run vapid`. La clave privada es secreta.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@amortoxico.com
# Envía los recordatorios programados desde este proceso (un solo servidor).
PUSH_SCHEDULER=true

# ── Comunidad ───────────────────────────────────────────────────────────────
# Exigir correo verificado para escribir en la comunidad.
COMMUNITY_REQUIRE_VERIFIED=true

# ── Navegador (se incluyen en el código público; nunca pongas secretos) ────
# Base de la API si se sirve en otro dominio (por defecto, /api en el mismo dominio).
VITE_API_BASE=
# `local` fuerza el modo sin servidor (solo para pruebas).
VITE_AUTH_MODE=
